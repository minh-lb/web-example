    "rxjs": "7.8.2",
    "mysql2": "3.14.4",
    "ioredis": "5.7.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/express": "5.0.3",
    "typescript": "5.9.2"
